# Copy to .env and fill in. Values already exported in your shell always win;
# .env.local (gitignored) is read first and overrides .env.
#
# Full reference: docs/configuration_zh.md

# ---------------------------------------------------------------------------
# Provider credentials (required)
# ---------------------------------------------------------------------------
# Every intelligent role (Discovery / Experience / Analyzer / Main Agent /
# Harness Editor) and every rolled-out candidate harness talks to this endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------------------------------------------------------------------------
# Paths (optional — defaults shown)
# ---------------------------------------------------------------------------
# Checkout root. Only needed when the package is installed outside the repo.
# HARNESSLENS_ROOT=/path/to/HarnessLens

# Agent runtimes. Anything already on PATH is preferred over these.
# OPENCODE_PREFIX=~/.opencode
# HAI_OPENCODE_BIN=~/.opencode/bin/opencode
# PI_AGENT_BIN=./.pi-agent/node_modules/.bin/pi
# HAI_CODEX_MODELS_CACHE=~/.codex/models_cache.json

# Terminal-Bench only: rootless docker state and the clash proxy controller.
# HAI_DOCKER_ROOT defaults to ~/dockers. If your rootless dockerd keeps its
# state on another volume, set this — otherwise the first rollout fails on an
# unreachable socket. `check_env.py --cell terminal-bench` resolves and reports
# the socket it will actually use.
# HAI_DOCKER_ROOT=~/dockers
# HAI_DOCKER_HOST=unix:///path/to/dockers/run/docker.sock
# TB_CLASHCTL_HOME=~/clashctl

# ---------------------------------------------------------------------------
# Budget and concurrency (optional — defaults shown)
# ---------------------------------------------------------------------------
# Total isolated intelligent sessions a single run may create.
# HAI_TOTAL_CREATION_BUDGET=200
# Repeats per TRAIN task; the reported experiments use 2.
# HAI_TRAIN_ROLLOUT_REPEATS=2
# HAI_MAX_ROLLOUT_CONCURRENCY=8
# HAI_MAX_ANALYSIS_CONCURRENCY=4
# HAI_PROVIDER_MAX_CONCURRENCY=16
